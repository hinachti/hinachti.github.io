rules_version = '2';

// The contact messages. Written only by the Apps Script (Code.gs), which uses
// the owner's own credentials and so does not pass through these rules at all.
// From a browser: the owner may read them, mark them read or handled, and
// delete them; nobody else may do anything, and nobody may create one.
//
// OWNER_EMAIL below is replaced with the real address when the rules are
// pasted into the Firebase console. The public repository keeps the
// placeholder, so the address never appears on the web.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null
        && request.auth.token.email == 'OWNER_EMAIL'
        && request.auth.token.email_verified == true;
    }

    match /messages/{id} {
      allow read, delete: if isOwner();
      allow update: if isOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'done']);
      allow create: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
